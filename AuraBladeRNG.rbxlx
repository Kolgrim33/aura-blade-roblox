			<Item class="ModuleScript" referent="RBX_MOD_ROLLENGINE">
				<Properties>
					<string name="Name">RollEngine</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	RollEngine.luau
	Weighted RNG & Pity calculation engine for AURA BLADE: RNG & BOSS ARENA.
	Computes effective player luck from all active sources (Rebirths, Gamepasses,
	Roblox Premium, Friends in Server, Sky Obby Buff, VIP Fountain, Server Boost,
	and Singularity Potions) and rolls single or triple Auras.
]]

local GameConfig = require(script.Parent.GameConfig)

export type LuckContext = {
	RebirthLevel: number,
	OwnsDoubleLuck: boolean,
	OwnsVIP: boolean,
	IsPremium: boolean,
	FriendsInServer: number,
	HasObbyBuff: boolean,
	HasVipFountainBuff: boolean,
	ServerBoostActive: boolean,
	UseHeavenlyPotion: boolean,
	TotalRolls: number,
}

export type LuckBreakdown = {
	BaseLuck: number,
	AdditiveBonus: number,
	Multiplier: number,
	TotalLuck: number,
	GuaranteedMinOneIn: number,
}

local RollEngine = {}

function RollEngine.ComputeLuck(ctx: LuckContext): LuckBreakdown
	local base = 1.0
	local additive = 0.0

	-- 1. Rebirth permanent luck bonus
	local rebirthInfo = GameConfig.GetRebirthTier(ctx.RebirthLevel)
	if rebirthInfo then
		additive += rebirthInfo.PermanentLuckBonus
	end

	-- 2. VIP Gamepass (+25% additive base luck)
	if ctx.OwnsVIP then
		additive += 0.25
	end

	-- 3. Roblox Premium subscriber bonus (+25% luck)
	if ctx.IsPremium then
		additive += GameConfig.PREMIUM_LUCK_BONUS
	end

	-- 4. Friends in server viral bonus (+10% per friend, up to +50%)
	local friendBonus = math.min(
		ctx.FriendsInServer * GameConfig.FRIEND_LUCK_BONUS_PER_FRIEND,
		GameConfig.MAX_FRIEND_LUCK_BONUS
	)
	additive += friendBonus

	-- 5. Sky Obby completion buff (+100% luck for 5 minutes)
	if ctx.HasObbyBuff then
		additive += GameConfig.OBBY_LUCK_BONUS
	end

	-- 6. VIP Fountain aura buff (+35% luck)
	if ctx.HasVipFountainBuff then
		additive += GameConfig.VIP_FOUNTAIN_LUCK_BONUS
	end

	-- 7. Singularity Potion (+500% next-roll burst)
	if ctx.UseHeavenlyPotion then
		additive += 5.0
	end

	-- Multiplicative stacks (2x Luck Gamepass & 2x Server Luck Party)
	local mult = 1.0
	if ctx.OwnsDoubleLuck then
		mult *= 2.0
	end
	if ctx.ServerBoostActive then
		mult *= 2.0
	end

	local totalLuck = (base + additive) * mult

	-- Pity floor calculation (next roll index = TotalRolls + 1)
	local nextRollNumber = ctx.TotalRolls + 1
	local guaranteedMinOneIn = 0
	if nextRollNumber % GameConfig.LEGENDARY_PITY_THRESHOLD == 0 then
		guaranteedMinOneIn = 3500 -- Guaranteed Legendary+
	elseif nextRollNumber % GameConfig.EPIC_PITY_THRESHOLD == 0 then
		guaranteedMinOneIn = 500 -- Guaranteed Epic+
	end

	return {
		BaseLuck = base,
		AdditiveBonus = additive,
		Multiplier = mult,
		TotalLuck = totalLuck,
		GuaranteedMinOneIn = guaranteedMinOneIn,
	}
end

--[[
	Rolls a single Aura using luck-scaled inverse-odds weighting.
	Higher luck boosts rare aura weights proportionally while clamping common weights
	so players genuinely feel every multiplier & potion!
]]
function RollEngine.RollSingle(ctx: LuckContext, rng: Random?): (GameConfig.AuraDefinition, LuckBreakdown)
	local randomGen = rng or Random.new()
	local breakdown = RollEngine.ComputeLuck(ctx)
	local luck = breakdown.TotalLuck

	-- Iterate from rarest (Celestial) down to Common
	for i = #GameConfig.Auras, 1, -1 do
		local aura = GameConfig.Auras[i]
		if aura.OneIn >= breakdown.GuaranteedMinOneIn then
			-- Effective 1-in-N odds scaled by total luck
			local effectiveOneIn = math.max(1.0, aura.OneIn / luck)
			local roll = randomGen:NextNumber() * effectiveOneIn
			if roll <= 1.0 then
				return aura, breakdown
			end
		end
	end

	-- Fallback to guaranteed pity tier if triggered
	if breakdown.GuaranteedMinOneIn > 0 then
		for _, aura in ipairs(GameConfig.Auras) do
			if aura.OneIn >= breakdown.GuaranteedMinOneIn then
				return aura, breakdown
			end
		end
	end

	return GameConfig.Auras[1], breakdown
end

--[[
	Rolls 1 or 3 Auras (when TripleRoll Gamepass is owned) and returns
	the best Aura rolled along with all rolled Auras for the UI display.
]]
function RollEngine.RollBatch(
	ctx: LuckContext,
	tripleRoll: boolean,
	rng: Random?
): (GameConfig.AuraDefinition, { GameConfig.AuraDefinition }, LuckBreakdown)
	local count = if tripleRoll then 3 else 1
	local allRolled: { GameConfig.AuraDefinition } = {}
	local bestAura: GameConfig.AuraDefinition? = nil
	local firstBreakdown: LuckBreakdown? = nil

	for i = 1, count do
		local subCtx: LuckContext = table.clone(ctx)
		subCtx.TotalRolls = ctx.TotalRolls + (i - 1)
		-- Heavenly Potion applies to the primary roll of the batch
		if i > 1 then
			subCtx.UseHeavenlyPotion = false
		end
		local rolled, breakdown = RollEngine.RollSingle(subCtx, rng)
		if not firstBreakdown then
			firstBreakdown = breakdown
		end
		table.insert(allRolled, rolled)
		if not bestAura or rolled.OneIn > bestAura.OneIn then
			bestAura = rolled
		end
	end

	return bestAura :: GameConfig.AuraDefinition, allRolled, firstBreakdown :: LuckBreakdown
end

return RollEngine
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX_SSS">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Folder" referent="RBX_SERVER_FOLDER">
			<Properties>
				<string name="Name">Server</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX_MOD_DATAMGR">
				<Properties>
					<string name="Name">DataManager</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	DataManager.luau
	Server-side DataStoreService persistence & OrderedDataStore leaderboard manager.
	Features:
	- Exponential backoff retry on GetAsync / UpdateAsync
	- Schema migration & default profile hydration
	- Idempotent PurchaseHistory ring-buffer for ProcessReceipt
	- Auto-save loop & BindToClose graceful shutdown
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

export type PlayerProfile = {
	SchemaVersion: number,
	Coins: number,
	Gems: number,
	TotalRolls: number,
	Rebirths: number,
	BestAuraId: string,
	BestAuraOneIn: number,
	EquippedAuraId: string,
	OwnedAuras: { string },
	HeavenlyPotions: number,
	FastRollTokens: number,
	BonusVaultSlots: number,
	BossKills: number,
	TotalDamageDealt: number,
	LastDailyClaimDay: number,
	DailyStreak: number,
	RedeemedCodes: { [string]: boolean },
	OwnedGamepasses: { [string]: boolean },
	ProcessedReceipts: { string },
	AutoRollEnabled: boolean,
	MinKeepOneIn: number,
}

local PROFILE_STORE_NAME = "AuraBladeProfile_v1"
local MAX_RECEIPT_HISTORY = 75

local DataManager = {}
DataManager.Profiles = {} :: { [Player]: PlayerProfile }
DataManager.Dirty = {} :: { [Player]: boolean }

local isStudio = RunService:IsStudio()
local profileStore: DataStore? = nil
local bestAuraLeaderboard: OrderedDataStore? = nil
local rebirthLeaderboard: OrderedDataStore? = nil

pcall(function()
	profileStore = DataStoreService:GetDataStore(PROFILE_STORE_NAME)
	bestAuraLeaderboard = DataStoreService:GetOrderedDataStore("AuraBlade_BestAura_v1")
	rebirthLeaderboard = DataStoreService:GetOrderedDataStore("AuraBlade_Rebirths_v1")
end)

function DataManager.CreateDefaultProfile(): PlayerProfile
	return {
		SchemaVersion = 1,
		Coins = 150,
		Gems = 50,
		TotalRolls = 0,
		Rebirths = 0,
		BestAuraId = "cyber_spark",
		BestAuraOneIn = 2,
		EquippedAuraId = "cyber_spark",
		OwnedAuras = { "cyber_spark" },
		HeavenlyPotions = 1, -- Give new players 1 free Singularity Potion to hook them early!
		FastRollTokens = 5,
		BonusVaultSlots = 0,
		BossKills = 0,
		TotalDamageDealt = 0,
		LastDailyClaimDay = 0,
		DailyStreak = 0,
		RedeemedCodes = {},
		OwnedGamepasses = {},
		ProcessedReceipts = {},
		AutoRollEnabled = false,
		MinKeepOneIn = 1,
	}
end

local function reconcileProfile(raw: any): PlayerProfile
	local def = DataManager.CreateDefaultProfile()
	if type(raw) ~= "table" then
		return def
	end
	for k, v in pairs(def :: any) do
		if raw[k] == nil then
			raw[k] = v
		end
	end
	return raw :: PlayerProfile
end

function DataManager.LoadProfile(player: Player): PlayerProfile
	local key = "Player_" .. tostring(player.UserId)
	local loadedData: any = nil

	if profileStore then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return profileStore:GetAsync(key)
			end)
			if ok then
				loadedData = result
				break
			else
				if not isStudio then
					warn(string.format("[DataManager] GetAsync attempt %d failed for %s: %s", attempt, player.Name, tostring(result)))
				end
				task.wait(0.5 * attempt)
			end
		end
	end

	local profile = reconcileProfile(loadedData)
	DataManager.Profiles[player] = profile
	DataManager.Dirty[player] = false

	DataManager.SyncLeaderstats(player)
	return profile
end

function DataManager.GetProfile(player: Player): PlayerProfile?
	return DataManager.Profiles[player]
end

function DataManager.MarkDirty(player: Player)
	DataManager.Dirty[player] = true
	DataManager.SyncLeaderstats(player)
end

function DataManager.GetMaxVaultSlots(player: Player): number
	local profile = DataManager.Profiles[player]
	if not profile then
		return GameConfig.BASE_INVENTORY_SLOTS
	end
	local slots = GameConfig.BASE_INVENTORY_SLOTS + profile.BonusVaultSlots
	local rebirthInfo = GameConfig.GetRebirthTier(profile.Rebirths)
	if rebirthInfo then
		slots += rebirthInfo.BonusInventorySlots
	end
	if profile.OwnedGamepasses["ExtraStorage"] then
		slots += 100
	end
	return slots
end

function DataManager.SyncLeaderstats(player: Player)
	local profile = DataManager.Profiles[player]
	if not profile then
		return
	end

	local leaderstats = player:FindFirstChild("leaderstats") :: Folder?
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local function setStat(name: string, value: any, className: string)
		local stat = leaderstats:FindFirstChild(name)
		if not stat then
			stat = Instance.new(className)
			stat.Name = name
			stat.Parent = leaderstats
		end
		(stat :: any).Value = value
	end

	local bestAura = GameConfig.GetAuraById(profile.BestAuraId)
	setStat("Aura", bestAura.Name, "StringValue")
	setStat("Rolls", profile.TotalRolls, "IntValue")
	setStat("Rebirths", profile.Rebirths, "IntValue")
	setStat("Coins", math.floor(profile.Coins), "IntValue")
end

function DataManager.SaveProfile(player: Player, force: boolean?): boolean
	local profile = DataManager.Profiles[player]
	if not profile then
		return false
	end
	if not force and not DataManager.Dirty[player] then
		return true
	end

	local key = "Player_" .. tostring(player.UserId)
	if profileStore then
		for attempt = 1, 3 do
			local ok, err = pcall(function()
				profileStore:UpdateAsync(key, function(_old)
					return profile
				end)
			end)
			if ok then
				DataManager.Dirty[player] = false
				break
			else
				if not isStudio then
					warn(string.format("[DataManager] UpdateAsync failed (%d) for %s: %s", attempt, player.Name, tostring(err)))
				end
				task.wait(0.5 * attempt)
			end
		end
	end

	-- Update Global OrderedDataStores
	if bestAuraLeaderboard and profile.BestAuraOneIn > 2 then
		pcall(function()
			bestAuraLeaderboard:SetAsync(key, profile.BestAuraOneIn)
		end)
	end
	if rebirthLeaderboard and profile.Rebirths > 0 then
		pcall(function()
			rebirthLeaderboard:SetAsync(key, profile.Rebirths)
		end)
	end

	return true
end

function DataManager.RecordReceipt(profile: PlayerProfile, purchaseId: string)
	table.insert(profile.ProcessedReceipts, purchaseId)
	while #profile.ProcessedReceipts > MAX_RECEIPT_HISTORY do
		table.remove(profile.ProcessedReceipts, 1)
	end
end

function DataManager.HasProcessedReceipt(profile: PlayerProfile, purchaseId: string): boolean
	return table.find(profile.ProcessedReceipts, purchaseId) ~= nil
end

function DataManager.CleanupPlayer(player: Player)
	DataManager.SaveProfile(player, true)
	DataManager.Profiles[player] = nil
	DataManager.Dirty[player] = nil
end

-- Periodic Auto-Save & Graceful Shutdown
function DataManager.StartAutoSaveLoop()
	task.spawn(function()
		while true do
			task.wait(90)
			for _, player in ipairs(Players:GetPlayers()) do
				DataManager.SaveProfile(player, false)
			end
		end
	end)

	game:BindToClose(function()
		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(function()
				DataManager.SaveProfile(player, true)
			end)
		end
		task.wait(2)
	end)
end

return DataManager
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX_MOD_MONETIZATION">
				<Properties>
					<string name="Name">MonetizationServer</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	MonetizationServer.luau
	Complete Robux & Gem monetization system for AURA BLADE: RNG & BOSS ARENA.
	Handles:
	- MarketplaceService.ProcessReceipt (idempotent Developer Products)
	- Gamepass ownership checks & PromptGamePassPurchaseFinished live grants
	- Studio Sandbox Purchase Mode (test all passes & products in Studio for free!)
	- Server-wide 2x Luck Party Boost timer
	- Friend-in-Server viral luck bonus & Roblox Premium EBP multiplier
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local DataManager = require(script.Parent.DataManager)

local MonetizationServer = {}
MonetizationServer.ServerLuckEndTime = 0
MonetizationServer.ServerBoostSponsor = ""
MonetizationServer.OnServerAnnouncement = nil :: ((string, Color3) -> ())?
MonetizationServer.OnForceSpawnOmegaBoss = nil :: ((Player) -> ())?
MonetizationServer.OnProfileUpdated = nil :: ((Player) -> ())?

function MonetizationServer.IsServerBoostActive(): boolean
	return os.time() < MonetizationServer.ServerLuckEndTime
end

function MonetizationServer.GetServerBoostRemaining(): number
	return math.max(0, MonetizationServer.ServerLuckEndTime - os.time())
end

function MonetizationServer.SyncPlayerGamepasses(player: Player)
	local profile = DataManager.GetProfile(player)
	if not profile then
		return
	end

	for _, gp in ipairs(GameConfig.Gamepasses) do
		if not profile.OwnedGamepasses[gp.Key] then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gp.Id)
			end)
			if ok and owns then
				profile.OwnedGamepasses[gp.Key] = true
			end
		end
	end
end

function MonetizationServer.OwnsGamepass(player: Player, key: string): boolean
	local profile = DataManager.GetProfile(player)
	if not profile then
		return false
	end
	return profile.OwnedGamepasses[key] == true
end

function MonetizationServer.CountFriendsInServer(player: Player): number
	local count = 0
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local ok, isFriend = pcall(function()
				return player:IsFriendsWith(other.UserId)
			end)
			if ok and isFriend then
				count += 1
			end
		end
	end
	return count
end

function MonetizationServer.GrantDevProductByKey(player: Player, key: string): boolean
	local profile = DataManager.GetProfile(player)
	if not profile then
		return false
	end

	if key == "ServerLuckBoost" then
		local now = os.time()
		local baseTime = math.max(now, MonetizationServer.ServerLuckEndTime)
		MonetizationServer.ServerLuckEndTime = baseTime + (15 * 60)
		MonetizationServer.ServerBoostSponsor = player.DisplayName
		if MonetizationServer.OnServerAnnouncement then
			MonetizationServer.OnServerAnnouncement(
				string.format("⚡ %s activated 2X SERVER LUCK PARTY for 15 minutes!", player.DisplayName),
				Color3.fromRGB(50, 255, 160)
			)
		end
	elseif key == "HeavenlyPotion" then
		profile.HeavenlyPotions += 1
	elseif key == "SummonOmegaBoss" then
		if MonetizationServer.OnForceSpawnOmegaBoss then
			MonetizationServer.OnForceSpawnOmegaBoss(player)
		end
		if MonetizationServer.OnServerAnnouncement then
			MonetizationServer.OnServerAnnouncement(
				string.format("🔥 %s summoned the OMEGA MECH OVERLORD in the Arena!", player.DisplayName),
				Color3.fromRGB(255, 85, 65)
			)
		end
	elseif key == "GemPackSmall" then
		profile.Gems += 1500
	elseif key == "GemPackMedium" then
		profile.Gems += 6000
	elseif key == "GemPackMega" then
		profile.Gems += 25000
		profile.HeavenlyPotions += 3
	else
		return false
	end

	DataManager.MarkDirty(player)
	if MonetizationServer.OnProfileUpdated then
		MonetizationServer.OnProfileUpdated(player)
	end
	return true
end

function MonetizationServer.GrantGamepassByKey(player: Player, key: string): boolean
	local profile = DataManager.GetProfile(player)
	if not profile then
		return false
	end
	local gp = GameConfig.GetGamepassByKey(key)
	if not gp then
		return false
	end

	profile.OwnedGamepasses[key] = true
	if key == "VIP" then
		profile.Coins += 2500
		profile.Gems += 300
	end

	DataManager.MarkDirty(player)
	if MonetizationServer.OnProfileUpdated then
		MonetizationServer.OnProfileUpdated(player)
	end
	if MonetizationServer.OnServerAnnouncement then
		MonetizationServer.OnServerAnnouncement(
			string.format("👑 %s unlocked the [%s] Gamepass!", player.DisplayName, gp.Name),
			gp.AccentColor
		)
	end
	return true
end

function MonetizationServer.PromptOrSimulatePurchase(player: Player, kind: string, key: string): (boolean, string)
	local isStudio = RunService:IsStudio()

	if kind == "Gamepass" then
		local gp = GameConfig.GetGamepassByKey(key)
		if not gp then
			return false, "Unknown Gamepass"
		end
		if MonetizationServer.OwnsGamepass(player, key) then
			return false, "You already own " .. gp.Name .. "!"
		end

		if isStudio and GameConfig.STUDIO_SANDBOX_PURCHASES then
			MonetizationServer.GrantGamepassByKey(player, key)
			return true, "[Studio Sandbox] Unlocked " .. gp.Name .. "!"
		end

		pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, gp.Id)
		end)
		return true, "Prompted " .. gp.Name
	elseif kind == "DevProduct" then
		local dp = GameConfig.GetDevProductByKey(key)
		if not dp then
			return false, "Unknown Product"
		end

		if isStudio and GameConfig.STUDIO_SANDBOX_PURCHASES then
			MonetizationServer.GrantDevProductByKey(player, key)
			return true, "[Studio Sandbox] Activated " .. dp.Name .. "!"
		end

		pcall(function()
			MarketplaceService:PromptProductPurchase(player, dp.Id)
		end)
		return true, "Prompted " .. dp.Name
	end

	return false, "Invalid purchase request"
end

function MonetizationServer.Init()
	-- Live Gamepass purchase listener
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		if not wasPurchased then
			return
		end
		local gp = GameConfig.GetGamepassById(gamePassId)
		if gp then
			MonetizationServer.GrantGamepassByKey(player, gp.Key)
		end
	end)

	-- Idempotent ProcessReceipt handler for all Developer Products
	MarketplaceService.ProcessReceipt = function(receiptInfo): Enum.ProductPurchaseDecision
		local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local profile = DataManager.GetProfile(player)
		if not profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local purchaseId = tostring(receiptInfo.PurchaseId)
		if DataManager.HasProcessedReceipt(profile, purchaseId) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end

		local dp = GameConfig.GetDevProductById(receiptInfo.ProductId)
		if not dp then
			warn("[MonetizationServer] Unrecognized ProductId:", receiptInfo.ProductId)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local granted = MonetizationServer.GrantDevProductByKey(player, dp.Key)
		if not granted then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		DataManager.RecordReceipt(profile, purchaseId)
		DataManager.SaveProfile(player, true)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

return MonetizationServer
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX_MOD_VISUALAURA">
				<Properties>
					<string name="Name">VisualAuraBuilder</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	VisualAuraBuilder.luau
	Procedural 3D Cyber Blade, Orbiting Aura Shards, Particle Rings, and
	Overhead Title BillboardGui generator for AURA BLADE: RNG & BOSS ARENA.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local VisualAuraBuilder = {}

type ActiveRigAura = {
	Folder: Folder,
	Orbs: { BasePart },
	PrimaryColor: Color3,
	OrbitRadius: number,
	OrbitSpeed: number,
}

local activeAuras: { [Model]: ActiveRigAura } = {}

local function formatCommaNumber(n: number): string
	local s = tostring(math.floor(n))
	return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

function VisualAuraBuilder.ClearCharacterVisuals(character: Model)
	activeAuras[character] = nil
	local existing = character:FindFirstChild("AuraBladeVisuals")
	if existing then
		existing:Destroy()
	end
	local head = character:FindFirstChild("Head")
	if head then
		local tag = head:FindFirstChild("AuraTitleBillboard")
		if tag then
			tag:Destroy()
		end
	end
end

function VisualAuraBuilder.ApplyAuraToCharacter(
	player: Player,
	auraId: string,
	rebirths: number,
	isVIP: boolean
)
	local character = player.Character
	if not character then
		return
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local head = character:FindFirstChild("Head") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not head or not humanoid then
		return
	end

	VisualAuraBuilder.ClearCharacterVisuals(character)
	local aura = GameConfig.GetAuraById(auraId)

	-- Apply movement speed bonus from equipped Aura
	humanoid.WalkSpeed = 18 + aura.SpeedBonus

	local visualsFolder = Instance.new("Folder")
	visualsFolder.Name = "AuraBladeVisuals"
	visualsFolder.Parent = character

	-- 1. Core PointLight & Particle Emitter on HumanoidRootPart
	local light = Instance.new("PointLight")
	light.Name = "AuraGlow"
	light.Color = aura.PrimaryColor
	light.Brightness = 2.5 + math.min(4, math.log10(math.max(2, aura.OneIn)))
	light.Range = 14 + math.min(18, aura.OrbitOrbs * 1.5)
	light.Parent = rootPart

	local particles = Instance.new("ParticleEmitter")
	particles.Name = "AuraSparks"
	particles.Color = ColorSequence.new(aura.PrimaryColor, aura.SecondaryColor)
	particles.LightEmission = 1
	particles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(0.6, 0.85),
		NumberSequenceKeypoint.new(1, 0),
	})
	particles.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	particles.Lifetime = NumberRange.new(0.7, 1.35)
	particles.Rate = 18 + (aura.OrbitOrbs * 6)
	particles.Speed = NumberRange.new(3, 8)
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.Parent = rootPart

	-- 2. Procedural 3D Cyber Katana welded to RightHand / Right Arm
	local hand = (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm") or rootPart) :: BasePart
	local bladeModel = Instance.new("Model")
	bladeModel.Name = "CyberKatana"
	bladeModel.Parent = visualsFolder

	local hilt = Instance.new("Part")
	hilt.Name = "Hilt"
	hilt.Size = Vector3.new(0.32, 0.32, 1.35)
	hilt.Material = Enum.Material.Metal
	hilt.Color = Color3.fromRGB(28, 32, 42)
	hilt.CanCollide = false
	hilt.Massless = true
	hilt.CFrame = hand.CFrame * CFrame.new(0, -0.4, -0.5)
	hilt.Parent = bladeModel

	local handWeld = Instance.new("WeldConstraint")
	handWeld.Part0 = hand
	handWeld.Part1 = hilt
	handWeld.Parent = hilt

	local bladeEdge = Instance.new("Part")
	bladeEdge.Name = "NeonEdge"
	bladeEdge.Size = Vector3.new(0.14, 0.36, 4.1)
	bladeEdge.Material = Enum.Material.Neon
	bladeEdge.Color = aura.PrimaryColor
	bladeEdge.CanCollide = false
	bladeEdge.Massless = true
	bladeEdge.CFrame = hilt.CFrame * CFrame.new(0, 0, -2.65)
	bladeEdge.Parent = bladeModel

	local bladeWeld = Instance.new("WeldConstraint")
	bladeWeld.Part0 = hilt
	bladeWeld.Part1 = bladeEdge
	bladeWeld.Parent = bladeEdge

	-- Slash Trail on the Neon Edge
	local att0 = Instance.new("Attachment")
	att0.Position = Vector3.new(0, 0.18, -2.0)
	att0.Parent = bladeEdge

	local att1 = Instance.new("Attachment")
	att1.Position = Vector3.new(0, -0.18, 2.0)
	att1.Parent = bladeEdge

	local trail = Instance.new("Trail")
	trail.Attachment0 = att0
	trail.Attachment1 = att1
	trail.Color = ColorSequence.new(aura.PrimaryColor, aura.SecondaryColor)
	trail.LightEmission = 1
	trail.Lifetime = 0.28
	trail.Transparency = NumberSequence.new(0.15, 1.0)
	trail.Parent = bladeEdge

	-- 3. Orbiting 3D Neon Shards around the player
	local orbs: { BasePart } = {}
	for i = 1, aura.OrbitOrbs do
		local orb = Instance.new("Part")
		orb.Name = "AuraOrb_" .. tostring(i)
		orb.Size = Vector3.new(0.65, 1.25, 0.65)
		orb.Material = Enum.Material.Neon
		orb.Color = if i % 2 == 0 then aura.SecondaryColor else aura.PrimaryColor
		orb.Anchored = true
		orb.CanCollide = false
		orb.CanQuery = false
		orb.CanTouch = false
		orb.CFrame = rootPart.CFrame
		orb.Parent = visualsFolder
		table.insert(orbs, orb)
	end

	activeAuras[character] = {
		Folder = visualsFolder,
		Orbs = orbs,
		PrimaryColor = aura.PrimaryColor,
		OrbitRadius = 4.2 + math.min(3.5, aura.OrbitOrbs * 0.25),
		OrbitSpeed = 2.0 + math.min(3.0, aura.OrbitOrbs * 0.2),
	}

	-- 4. Overhead Title & Odds BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Name = "AuraTitleBillboard"
	bb.Adornee = head
	bb.Size = UDim2.new(0, 240, 0, 72)
	bb.StudsOffset = Vector3.new(0, 3.1, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 120
	bb.Parent = head

	local topLine = Instance.new("TextLabel")
	topLine.BackgroundTransparency = 1
	topLine.Size = UDim2.new(1, 0, 0.36, 0)
	topLine.Font = Enum.Font.GothamBold
	local vipPrefix = if isVIP then "👑 [VIP] " else ""
	local rebInfo = GameConfig.GetRebirthTier(rebirths)
	local rebTag = if rebInfo then string.format("[%s] ", rebInfo.Title) else ""
	topLine.Text = vipPrefix .. rebTag .. player.DisplayName
	topLine.TextColor3 = if isVIP then Color3.fromRGB(255, 220, 65) else Color3.fromRGB(235, 240, 255)
	topLine.TextScaled = true
	topLine.TextStrokeTransparency = 0.25
	topLine.Parent = bb

	local auraLine = Instance.new("TextLabel")
	auraLine.BackgroundTransparency = 1
	auraLine.Position = UDim2.new(0, 0, 0.36, 0)
	auraLine.Size = UDim2.new(1, 0, 0.64, 0)
	auraLine.Font = Enum.Font.GothamBlack
	auraLine.Text = string.format("★ %s [1 in %s] ★", string.upper(aura.Name), formatCommaNumber(aura.OneIn))
	auraLine.TextColor3 = aura.PrimaryColor
	auraLine.TextScaled = true
	auraLine.TextStrokeTransparency = 0.15
	auraLine.Parent = bb
end

function VisualAuraBuilder.StartOrbitLoop()
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for character, data in pairs(activeAuras) do
			local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not character.Parent or not root then
				activeAuras[character] = nil
				continue
			end

			local count = #data.Orbs
			for i, orb in ipairs(data.Orbs) do
				if orb.Parent then
					local angle = (t * data.OrbitSpeed) + ((i - 1) * (math.pi * 2 / count))
					local bob = math.sin((t * 3.2) + i) * 0.85
					local offset = Vector3.new(
						math.cos(angle) * data.OrbitRadius,
						bob,
						math.sin(angle) * data.OrbitRadius
					)
					local targetPos = root.Position + offset
					orb.CFrame = CFrame.lookAt(targetPos, root.Position) * CFrame.Angles(t * 2, 0, 0)
				end
			end
		end
	end)
end

return VisualAuraBuilder
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX_MOD_WORLDBUILDER">
				<Properties>
					<string name="Name">WorldBuilder</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	WorldBuilder.luau
	Procedural 3D Neon Cyber Arena, Sky Obby Course, VIP Lounge,
	Mythic Showcase Pedestals, and Physical Leaderboard builder.
	Generates the entire playable world automatically on Server boot!
]]

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local WorldBuilder = {}

local function createPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		(p :: any)[k] = v
	end
	return p
end

local function attachBillboardSign(parent: BasePart, title: string, subtitle: string, accentColor: Color3)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 260, 0, 80)
	bb.StudsOffset = Vector3.new(0, 4.5, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 150
	bb.Parent = parent

	local lbl1 = Instance.new("TextLabel")
	lbl1.BackgroundTransparency = 1
	lbl1.Size = UDim2.new(1, 0, 0.55, 0)
	lbl1.Font = Enum.Font.GothamBlack
	lbl1.Text = title
	lbl1.TextColor3 = accentColor
	lbl1.TextScaled = true
	lbl1.TextStrokeTransparency = 0.2
	lbl1.Parent = bb

	local lbl2 = Instance.new("TextLabel")
	lbl2.BackgroundTransparency = 1
	lbl2.Position = UDim2.new(0, 0, 0.55, 0)
	lbl2.Size = UDim2.new(1, 0, 0.45, 0)
	lbl2.Font = Enum.Font.GothamBold
	lbl2.Text = subtitle
	lbl2.TextColor3 = Color3.fromRGB(235, 240, 255)
	lbl2.TextScaled = true
	lbl2.TextStrokeTransparency = 0.3
	lbl2.Parent = bb
end

function WorldBuilder.ConfigureLighting()
	Lighting.Ambient = Color3.fromRGB(22, 26, 42)
	Lighting.OutdoorAmbient = Color3.fromRGB(32, 38, 64)
	Lighting.Brightness = 2.2
	Lighting.ClockTime = 0
	Lighting.FogEnd = 1200
	Lighting.FogColor = Color3.fromRGB(10, 12, 24)

	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.65
		bloom.Size = 24
		bloom.Threshold = 0.85
		bloom.Parent = Lighting
	end
end

function WorldBuilder.BuildWorld(
	onObbyPadTouched: (Player) -> (),
	onVipFountainTouched: (Player) -> (),
	onQuickShopPedestalTouched: (Player, string, string) -> ()
): Folder
	WorldBuilder.ConfigureLighting()

	local existing = Workspace:FindFirstChild("AuraBladeWorld")
	if existing then
		existing:Destroy()
	end

	-- Remove default Baseplate if present so our custom Cyber Plaza shines
	local defaultBaseplate = Workspace:FindFirstChild("Baseplate")
	if defaultBaseplate then
		defaultBaseplate:Destroy()
	end

	local world = Instance.new("Folder")
	world.Name = "AuraBladeWorld"
	world.Parent = Workspace

	-- 1. CENTRAL CYBER PLAZA FLOOR
	createPart({
		Name = "CyberPlazaFloor",
		Size = Vector3.new(280, 4, 280),
		Position = Vector3.new(0, -2, 0),
		Color = Color3.fromRGB(18, 22, 34),
		Material = Enum.Material.Concrete,
		Parent = world,
	})

	-- Glowing Neon Grid Lines on the Plaza
	for offset = -120, 120, 30 do
		createPart({
			Name = "NeonGridX_" .. tostring(offset),
			Size = Vector3.new(260, 0.15, 0.65),
			Position = Vector3.new(0, 0.05, offset),
			Color = Color3.fromRGB(0, 180, 255),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = world,
		})
		createPart({
			Name = "NeonGridZ_" .. tostring(offset),
			Size = Vector3.new(0.65, 0.15, 260),
			Position = Vector3.new(offset, 0.05, 0),
			Color = Color3.fromRGB(0, 180, 255),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = world,
		})
	end

	-- 2. SPAWN LOCATION (South Plaza)
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Name = "CyberSpawn"
	spawnLoc.Anchored = true
	spawnLoc.Size = Vector3.new(18, 1.2, 18)
	spawnLoc.Position = Vector3.new(0, 0.6, 70)
	spawnLoc.Color = Color3.fromRGB(0, 225, 255)
	spawnLoc.Material = Enum.Material.Neon
	spawnLoc.Neutral = true
	spawnLoc.TopSurface = Enum.SurfaceType.Smooth
	spawnLoc.Parent = world

	attachBillboardSign(
		spawnLoc,
		"⚔️ AURA BLADE: RNG & BOSS ARENA ⚔️",
		"Roll Mythic Auras • Slash Arena Bosses • Conquer the 2x Luck Sky Obby!",
		Color3.fromRGB(0, 235, 255)
	)

	-- 3. CENTER BOSS COLOSSEUM ARENA (Origin 0, 0, -10)
	local arenaFloor = createPart({
		Name = "BossColosseumFloor",
		Size = Vector3.new(76, 1.5, 76),
		Position = Vector3.new(0, 0.75, -10),
		Color = Color3.fromRGB(28, 18, 42),
		Material = Enum.Material.Granite,
		Parent = world,
	})

	createPart({
		Name = "BossSpawnAltar",
		Size = Vector3.new(14, 1.2, 14),
		Position = Vector3.new(0, 1.8, -10),
		Color = Color3.fromRGB(255, 55, 95),
		Material = Enum.Material.Neon,
		Parent = world,
	})

	attachBillboardSign(
		arenaFloor,
		"🔥 BOSS COLOSSEUM ARENA 🔥",
		"Click or Press [F] to Slash Bosses for Massive Flux Coins, Gems & Free Fast Rolls!",
		Color3.fromRGB(255, 75, 95)
	)

	-- 4. PHYSICAL ROBUX & BOOSTER PEDESTALS (High-visibility 3D impulse conversion pads)
	local shopPads = {
		{
			Pos = Vector3.new(-32, 1.2, 52),
			Kind = "Gamepass",
			Key = "DoubleLuck",
			Title = "🍀 2X LUCK FOREVER",
			Sub = "Step to Unlock Permanent 2x Roll Luck!",
			Color = Color3.fromRGB(45, 255, 130),
		},
		{
			Pos = Vector3.new(-16, 1.2, 52),
			Kind = "Gamepass",
			Key = "TripleRoll",
			Title = "⚡ 3X TRIPLE ROLL",
			Sub = "Roll 3 Auras At Once!",
			Color = Color3.fromRGB(255, 185, 35),
		},
		{
			Pos = Vector3.new(16, 1.2, 52),
			Kind = "Gamepass",
			Key = "VIP",
			Title = "👑 VIP CYBER SOVEREIGN",
			Sub = "+50% Coins, +25% Luck & Crown!",
			Color = Color3.fromRGB(255, 220, 55),
		},
		{
			Pos = Vector3.new(32, 1.2, 52),
			Kind = "DevProduct",
			Key = "ServerLuckBoost",
			Title = "🎉 2X SERVER LUCK PARTY",
			Sub = "Boost the Entire Server for 15m!",
			Color = Color3.fromRGB(185, 85, 255),
		},
	}

	local padDebounce: { [Player]: number } = {}
	for _, info in ipairs(shopPads) do
		local pad = createPart({
			Name = "ShopPad_" .. info.Key,
			Size = Vector3.new(8, 1.4, 8),
			Position = info.Pos,
			Color = info.Color,
			Material = Enum.Material.Neon,
			Parent = world,
		})
		attachBillboardSign(pad, info.Title, info.Sub, info.Color)

		pad.Touched:Connect(function(hit)
			local char = hit.Parent
			local player = if char then game:GetService("Players"):GetPlayerFromCharacter(char) else nil
			if player then
				local now = os.clock()
				if (padDebounce[player] or 0) + 3.0 < now then
					padDebounce[player] = now
					onQuickShopPedestalTouched(player, info.Kind, info.Key)
				end
			end
		end)
	end

	-- 5. VIP CYBER LOUNGE (+35% LUCK FOUNTAIN) - West Plaza
	local vipBase = createPart({
		Name = "VipLoungePlatform",
		Size = Vector3.new(36, 2, 36),
		Position = Vector3.new(-82, 1, 0),
		Color = Color3.fromRGB(48, 40, 18),
		Material = Enum.Material.Marble,
		Parent = world,
	})

	local vipFountain = createPart({
		Name = "VipLuckFountain",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4, 12, 12),
		CFrame = CFrame.new(-82, 3.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 215, 50),
		Material = Enum.Material.Neon,
		Parent = world,
	})
	attachBillboardSign(
		vipFountain,
		"👑 VIP & REBIRTH 3+ SANCTUM 👑",
		"Touch for +35% Bonus Aura Roll Luck!",
		Color3.fromRGB(255, 215, 50)
	)
	local _ = vipBase

	local vipDebounce: { [Player]: number } = {}
	vipFountain.Touched:Connect(function(hit)
		local char = hit.Parent
		local player = if char then game:GetService("Players"):GetPlayerFromCharacter(char) else nil
		if player then
			local now = os.clock()
			if (vipDebounce[player] or 0) + 2.0 < now then
				vipDebounce[player] = now
				onVipFountainTouched(player)
			end
		end
	end)

	-- 6. NEON SKY OBBY COURSE (East Plaza -> Ascends to +100% 2X LUCK SUMMIT PAD)
	local obbyFolder = Instance.new("Folder")
	obbyFolder.Name = "NeonSkyObby"
	obbyFolder.Parent = world

	local startSign = createPart({
		Name = "ObbyStartPad",
		Size = Vector3.new(12, 1.5, 12),
		Position = Vector3.new(62, 1, 45),
		Color = Color3.fromRGB(0, 255, 155),
		Material = Enum.Material.Neon,
		Parent = obbyFolder,
	})
	attachBillboardSign(
		startSign,
		"🏃 NEON SKY OBBY START 🏃",
		"Reach the Summit for 5 Minutes of +100% (2X) ROLL LUCK + 500 Bonus Coins!",
		Color3.fromRGB(0, 255, 155)
	)

	local numStages = 12
	for i = 1, numStages do
		local zPos = 45 - (i * 10)
		local xOffset = math.sin(i * 0.9) * 8
		local yPos = 1 + (i * 3.2)
		createPart({
			Name = "ObbyStep_" .. tostring(i),
			Size = Vector3.new(7, 1.2, 5.5),
			Position = Vector3.new(68 + xOffset, yPos, zPos),
			Color = Color3.fromHSV((i / numStages) * 0.75, 0.85, 1.0),
			Material = Enum.Material.Neon,
			Parent = obbyFolder,
		})
	end

	local summitPad = createPart({
		Name = "ObbySummitPad",
		Size = Vector3.new(16, 2, 16),
		Position = Vector3.new(68, 1 + ((numStages + 1) * 3.2), 45 - ((numStages + 1) * 10)),
		Color = Color3.fromRGB(50, 255, 130),
		Material = Enum.Material.Neon,
		Parent = obbyFolder,
	})
	attachBillboardSign(
		summitPad,
		"🏆 SKY OBBY SUMMIT: +100% LUCK! 🏆",
		"Step Here to Claim +100% Roll Luck (5m) + 500 Flux Coins & Return to Plaza!",
		Color3.fromRGB(50, 255, 130)
	)

	local obbyDebounce: { [Player]: number } = {}
	summitPad.Touched:Connect(function(hit)
		local char = hit.Parent
		local player = if char then game:GetService("Players"):GetPlayerFromCharacter(char) else nil
		if player then
			local now = os.clock()
			if (obbyDebounce[player] or 0) + 4.0 < now then
				obbyDebounce[player] = now
				onObbyPadTouched(player)
				local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					root.CFrame = spawnLoc.CFrame + Vector3.new(0, 4, 0)
				end
			end
		end
	end)

	-- 7. MYTHIC & CELESTIAL AURA SHOWCASE MONOLITHS (North Plaza)
	local showcaseIndices = { 10, 12, 13, 16 }
	for idx, auraIndex in ipairs(showcaseIndices) do
		local aura = GameConfig.Auras[auraIndex]
		if aura then
			local xPos = -45 + ((idx - 1) * 30)
			local pedestal = createPart({
				Name = "Showcase_" .. aura.Id,
				Size = Vector3.new(8, 10, 4),
				Position = Vector3.new(xPos, 5, -78),
				Color = aura.PrimaryColor,
				Material = Enum.Material.Neon,
				Parent = world,
			})
			attachBillboardSign(
				pedestal,
				string.format("★ %s ★", aura.Name),
				string.format("[%s • 1 in %d] +%d DMG | %gx Coins", aura.Tier, aura.OneIn, aura.BaseDamage, aura.CoinMultiplier),
				aura.PrimaryColor
			)
		end
	end

	return world
end

return WorldBuilder
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX_MOD_COMBATBOSS">
				<Properties>
					<string name="Name">CombatAndBossServer</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CombatAndBossServer.luau
	Active Boss Wave Spawner, Procedural 3D Cyber Boss Rig, AoE Telegraph AI,
	Server-Validated Sword Slash & Dash Combat, and Damage-Share Loot Payouts.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local DataManager = require(script.Parent.DataManager)
local MonetizationServer = require(script.Parent.MonetizationServer)

local CombatAndBossServer = {}

export type ActiveBossState = {
	Def: GameConfig.BossDefinition,
	Model: Model,
	CorePart: Part,
	CurrentHP: number,
	MaxHP: number,
	DamageContributors: { [Player]: number },
	BonusLootMultiplier: number,
}

CombatAndBossServer.CurrentBoss = nil :: ActiveBossState?
CombatAndBossServer.BossCounter = 0
CombatAndBossServer.OnBossStateChanged = nil :: ((string, number, number, Color3) -> ())?
CombatAndBossServer.OnBossDefeated = nil :: ((Player, string, number, number, number) -> ())?

local slashCooldowns: { [Player]: number } = {}
local ARENA_CENTER = Vector3.new(0, 6.5, -10)
local SLASH_RANGE = 26

local function updateBossBillboard(boss: ActiveBossState)
	local bb = boss.CorePart:FindFirstChild("BossBillboard") :: BillboardGui?
	if not bb then
		return
	end
	local hpLabel = bb:FindFirstChild("HPLabel") :: TextLabel?
	local fill = bb:FindFirstChild("BarBg") and (bb.BarBg :: Frame):FindFirstChild("Fill") :: Frame?
	if hpLabel then
		hpLabel.Text = string.format("%s — %d / %d HP", boss.Def.Name, math.max(0, math.floor(boss.CurrentHP)), boss.MaxHP)
	end
	if fill then
		local ratio = math.clamp(boss.CurrentHP / boss.MaxHP, 0, 1)
		fill.Size = UDim2.new(ratio, 0, 1, 0)
	end
end

function CombatAndBossServer.SpawnBoss(def: GameConfig.BossDefinition, bonusMultiplier: number?)
	if CombatAndBossServer.CurrentBoss and CombatAndBossServer.CurrentBoss.Model.Parent then
		CombatAndBossServer.CurrentBoss.Model:Destroy()
	end

	local mult = bonusMultiplier or 1.0
	local model = Instance.new("Model")
	model.Name = "ArenaBoss_" .. def.Id

	local scale = def.Scale
	local core = Instance.new("Part")
	core.Name = "BossCore"
	core.Anchored = true
	core.Size = Vector3.new(6.5 * scale, 9.0 * scale, 4.5 * scale)
	core.Position = ARENA_CENTER + Vector3.new(0, 2.5 * scale, 0)
	core.Color = Color3.fromRGB(26, 30, 44)
	core.Material = Enum.Material.Metal
	core.Parent = model

	local chestNeon = Instance.new("Part")
	chestNeon.Name = "ReactorCore"
	chestNeon.Shape = Enum.PartType.Ball
	chestNeon.Anchored = true
	chestNeon.CanCollide = false
	chestNeon.Size = Vector3.new(3.6 * scale, 3.6 * scale, 3.6 * scale)
	chestNeon.Position = core.Position + Vector3.new(0, 0.8 * scale, 0)
	chestNeon.Color = def.PrimaryColor
	chestNeon.Material = Enum.Material.Neon
	chestNeon.Parent = model

	local ring = Instance.new("Part")
	ring.Name = "EnergyHalo"
	ring.Anchored = true
	ring.CanCollide = false
	ring.Size = Vector3.new(10 * scale, 0.5 * scale, 10 * scale)
	ring.Position = core.Position + Vector3.new(0, 5.2 * scale, 0)
	ring.Color = def.PrimaryColor
	ring.Material = Enum.Material.Neon
	ring.Parent = model

	-- Boss Overhead HP Bar
	local bb = Instance.new("BillboardGui")
	bb.Name = "BossBillboard"
	bb.Size = UDim2.new(0, 320, 0, 76)
	bb.StudsOffset = Vector3.new(0, 7.5 * scale, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 200
	bb.Parent = core

	local hpLabel = Instance.new("TextLabel")
	hpLabel.Name = "HPLabel"
	hpLabel.BackgroundTransparency = 1
	hpLabel.Size = UDim2.new(1, 0, 0.55, 0)
	hpLabel.Font = Enum.Font.GothamBlack
	hpLabel.TextColor3 = def.PrimaryColor
	hpLabel.TextScaled = true
	hpLabel.TextStrokeTransparency = 0.15
	hpLabel.Parent = bb

	local barBg = Instance.new("Frame")
	barBg.Name = "BarBg"
	barBg.Position = UDim2.new(0.05, 0, 0.62, 0)
	barBg.Size = UDim2.new(0.9, 0, 0.28, 0)
	barBg.BackgroundColor3 = Color3.fromRGB(20, 24, 34)
	barBg.BorderSizePixel = 0
	barBg.Parent = bb

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = def.PrimaryColor
	fill.BorderSizePixel = 0
	fill.Parent = barBg

	model.PrimaryPart = core
	model.Parent = Workspace

	local state: ActiveBossState = {
		Def = def,
		Model = model,
		CorePart = core,
		CurrentHP = def.MaxHP,
		MaxHP = def.MaxHP,
		DamageContributors = {},
		BonusLootMultiplier = mult,
	}
	CombatAndBossServer.CurrentBoss = state
	updateBossBillboard(state)

	if CombatAndBossServer.OnBossStateChanged then
		CombatAndBossServer.OnBossStateChanged(def.Name, state.CurrentHP, state.MaxHP, def.PrimaryColor)
	end
end

function CombatAndBossServer.HandlePlayerSlash(player: Player): (boolean, number, boolean)
	local now = os.clock()
	if (slashCooldowns[player] or 0) + 0.32 > now then
		return false, 0, false
	end
	slashCooldowns[player] = now

	local profile = DataManager.GetProfile(player)
	if not profile then
		return false, 0, false
	end

	local char = player.Character
	local root = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	if not root then
		return false, 0, false
	end

	local boss = CombatAndBossServer.CurrentBoss
	if not boss or boss.CurrentHP <= 0 or not boss.CorePart.Parent then
		return false, 0, false
	end

	local dist = (root.Position - boss.CorePart.Position).Magnitude
	if dist > SLASH_RANGE then
		return false, 0, false
	end

	local aura = GameConfig.GetAuraById(profile.EquippedAuraId)
	local isCrit = math.random() < 0.22
	local dmg = math.floor(aura.BaseDamage * (if isCrit then 1.75 else 1.0))

	-- Small instant coin reward on every hit so combat feels super rewarding
	local hitCoins = math.max(1, math.floor(2 * aura.CoinMultiplier))
	profile.Coins += hitCoins
	profile.TotalDamageDealt += dmg

	boss.CurrentHP = math.max(0, boss.CurrentHP - dmg)
	boss.DamageContributors[player] = (boss.DamageContributors[player] or 0) + dmg
	updateBossBillboard(boss)

	if CombatAndBossServer.OnBossStateChanged then
		CombatAndBossServer.OnBossStateChanged(boss.Def.Name, boss.CurrentHP, boss.MaxHP, boss.Def.PrimaryColor)
	end

	if boss.CurrentHP <= 0 then
		CombatAndBossServer.ResolveBossDefeat(boss)
	else
		DataManager.MarkDirty(player)
	end

	return true, dmg, isCrit
end

function CombatAndBossServer.ResolveBossDefeat(boss: ActiveBossState)
	CombatAndBossServer.CurrentBoss = nil
	if boss.Model.Parent then
		boss.Model:Destroy()
	end

	for contributor, dmgDealt in pairs(boss.DamageContributors) do
		if contributor.Parent and dmgDealt > 0 then
			local profile = DataManager.GetProfile(contributor)
			if profile then
				local aura = GameConfig.GetAuraById(profile.EquippedAuraId)
				local rebInfo = GameConfig.GetRebirthTier(profile.Rebirths)
				local rebCoinMult = if rebInfo then rebInfo.PermanentCoinMultiplier else 1.0
				local vipMult = if MonetizationServer.OwnsGamepass(contributor, "VIP") then 1.5 else 1.0
				local premMult = if contributor.MembershipType == Enum.MembershipType.Premium
					then GameConfig.PREMIUM_COIN_MULTIPLIER
					else 1.0

				local totalCoinMult = aura.CoinMultiplier * rebCoinMult * vipMult * premMult * boss.BonusLootMultiplier
				local coinsEarned = math.floor(boss.Def.RewardCoins * totalCoinMult)
				local gemsEarned = math.floor(boss.Def.RewardGems * boss.BonusLootMultiplier)
				local fastRollsEarned = math.floor(boss.Def.RewardFastRolls * boss.BonusLootMultiplier)

				profile.Coins += coinsEarned
				profile.Gems += gemsEarned
				profile.FastRollTokens += fastRollsEarned
				profile.BossKills += 1
				DataManager.MarkDirty(contributor)

				if CombatAndBossServer.OnBossDefeated then
					CombatAndBossServer.OnBossDefeated(
						contributor,
						boss.Def.Name,
						coinsEarned,
						gemsEarned,
						fastRollsEarned
					)
				end
			end
		end
	end

	if CombatAndBossServer.OnBossStateChanged then
		CombatAndBossServer.OnBossStateChanged("Respawning in 8s...", 0, 100, Color3.fromRGB(140, 150, 175))
	end
end

function CombatAndBossServer.StartDirectorLoop()
	task.spawn(function()
		while true do
			if not CombatAndBossServer.CurrentBoss then
				CombatAndBossServer.BossCounter += 1
				local idx = ((CombatAndBossServer.BossCounter - 1) % #GameConfig.Bosses) + 1
				CombatAndBossServer.SpawnBoss(GameConfig.Bosses[idx], 1.0)
			else
				-- Boss idle hover + periodic shockwave ring visual
				local boss = CombatAndBossServer.CurrentBoss
				if boss and boss.CorePart.Parent then
					local pulse = Instance.new("Part")
					pulse.Name = "BossPulseRing"
					pulse.Anchored = true
					pulse.CanCollide = false
					pulse.Shape = Enum.PartType.Cylinder
					pulse.Color = boss.Def.PrimaryColor
					pulse.Material = Enum.Material.Neon
					pulse.Transparency = 0.45
					pulse.Size = Vector3.new(0.4, 16, 16)
					pulse.CFrame = CFrame.new(ARENA_CENTER.X, 1.6, ARENA_CENTER.Z) * CFrame.Angles(0, 0, math.rad(90))
					pulse.Parent = Workspace
					task.delay(0.55, function()
						if pulse.Parent then
							pulse:Destroy()
						end
					end)
				end
			end
			task.wait(8)
		end
	end)
end

return CombatAndBossServer
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX_SCRIPT_GAMESERVER">
				<Properties>
					<string name="Name">GameServer</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	GameServer.server.luau
	Master Server Script for AURA BLADE: RNG & BOSS ARENA.
	Wires ReplicatedStorage RemoteEvents/RemoteFunctions, Player lifecycle,
	Rolling, Auto-Roll loop, Rebirths, Gem Shop, Daily Streak, Promo Codes,
	3D World generation, Character Auras, and Arena Boss combat.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local RollEngine = require(Shared:WaitForChild("RollEngine"))

local DataManager = require(script.Parent:WaitForChild("DataManager"))
local MonetizationServer = require(script.Parent:WaitForChild("MonetizationServer"))
local VisualAuraBuilder = require(script.Parent:WaitForChild("VisualAuraBuilder"))
local WorldBuilder = require(script.Parent:WaitForChild("WorldBuilder"))
local CombatAndBossServer = require(script.Parent:WaitForChild("CombatAndBossServer"))

-- Create RemoteEvents & RemoteFunctions Folder
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local function createRemoteEvent(name: string): RemoteEvent
	local existing = (remotesFolder :: Folder):FindFirstChild(name) :: RemoteEvent?
	if existing then
		return existing
	end
	local ev = Instance.new("RemoteEvent")
	ev.Name = name
	ev.Parent = remotesFolder
	return ev
end

local function createRemoteFunction(name: string): RemoteFunction
	local existing = (remotesFolder :: Folder):FindFirstChild(name) :: RemoteFunction?
	if existing then
		return existing
	end
	local fn = Instance.new("RemoteFunction")
	fn.Name = name
	fn.Parent = remotesFolder
	return fn
end

local StateSyncEvent = createRemoteEvent("StateSync")
local RollResultEvent = createRemoteEvent("RollResult")
local ServerAnnounceEvent = createRemoteEvent("ServerAnnounce")
local CombatSlashEvent = createRemoteEvent("CombatSlash")
local CombatHitFeedbackEvent = createRemoteEvent("CombatHitFeedback")
local BossStateEvent = createRemoteEvent("BossState")
local ActionRequestFunc = createRemoteFunction("ActionRequest")

-- Timed Per-Player Buff Tracking (Sky Obby & VIP Fountain)
local obbyBuffExpiry: { [Player]: number } = {}
local vipFountainExpiry: { [Player]: number } = {}
local lastRollTimestamp: { [Player]: number } = {}

local function getObbyRemaining(player: Player): number
	return math.max(0, (obbyBuffExpiry[player] or 0) - os.time())
end

local function getVipFountainRemaining(player: Player): number
	return math.max(0, (vipFountainExpiry[player] or 0) - os.time())
end

local function buildLuckContext(player: Player, profile: DataManager.PlayerProfile, usePotion: boolean): RollEngine.LuckContext
	return {
		RebirthLevel = profile.Rebirths,
		OwnsDoubleLuck = MonetizationServer.OwnsGamepass(player, "DoubleLuck"),
		OwnsVIP = MonetizationServer.OwnsGamepass(player, "VIP"),
		IsPremium = (player.MembershipType == Enum.MembershipType.Premium),
		FriendsInServer = MonetizationServer.CountFriendsInServer(player),
		HasObbyBuff = getObbyRemaining(player) > 0,
		HasVipFountainBuff = getVipFountainRemaining(player) > 0,
		ServerBoostActive = MonetizationServer.IsServerBoostActive(),
		UseHeavenlyPotion = usePotion,
		TotalRolls = profile.TotalRolls,
	}
end

local function syncPlayerState(player: Player)
	local profile = DataManager.GetProfile(player)
	if not profile then
		return
	end
	local luckCtx = buildLuckContext(player, profile, false)
	local luckBreakdown = RollEngine.ComputeLuck(luckCtx)

	StateSyncEvent:FireClient(player, {
		Profile = profile,
		MaxVaultSlots = DataManager.GetMaxVaultSlots(player),
		TotalLuck = luckBreakdown.TotalLuck,
		ObbyBuffRemaining = getObbyRemaining(player),
		VipFountainRemaining = getVipFountainRemaining(player),
		ServerBoostRemaining = MonetizationServer.GetServerBoostRemaining(),
		ServerBoostSponsor = MonetizationServer.ServerBoostSponsor,
		FriendsInServer = luckCtx.FriendsInServer,
		IsPremium = luckCtx.IsPremium,
	})
end

local function refreshCharacterVisuals(player: Player)
	local profile = DataManager.GetProfile(player)
	if not profile then
		return
	end
	VisualAuraBuilder.ApplyAuraToCharacter(
		player,
		profile.EquippedAuraId,
		profile.Rebirths,
		MonetizationServer.OwnsGamepass(player, "VIP")
	)
end

local function performPlayerRoll(player: Player, useHeavenlyPotion: boolean, useFastToken: boolean): (boolean, string)
	local profile = DataManager.GetProfile(player)
	if not profile then
		return false, "Profile still loading..."
	end

	local now = os.clock()
	local ownsFast = MonetizationServer.OwnsGamepass(player, "FastRoll")
	local cooldown = if ownsFast then GameConfig.FAST_ROLL_COOLDOWN else GameConfig.BASE_ROLL_COOLDOWN

	if useFastToken and profile.FastRollTokens > 0 then
		profile.FastRollTokens -= 1
		cooldown = 0.12
	end

	if (lastRollTimestamp[player] or 0) + cooldown > now then
		return false, "Roll cooling down!"
	end
	lastRollTimestamp[player] = now

	local consumePotion = false
	if useHeavenlyPotion and profile.HeavenlyPotions > 0 then
		profile.HeavenlyPotions -= 1
		consumePotion = true
	end

	local tripleRoll = MonetizationServer.OwnsGamepass(player, "TripleRoll")
	local ctx = buildLuckContext(player, profile, consumePotion)
	local bestAura, allRolled, breakdown = RollEngine.RollBatch(ctx, tripleRoll)

	profile.TotalRolls += #allRolled

	-- Passive Coin gain per roll (scales with Aura + Rebirth + VIP + Premium)
	local equippedAura = GameConfig.GetAuraById(profile.EquippedAuraId)
	local rebInfo = GameConfig.GetRebirthTier(profile.Rebirths)
	local rebMult = if rebInfo then rebInfo.PermanentCoinMultiplier else 1.0
	local vipMult = if MonetizationServer.OwnsGamepass(player, "VIP") then 1.5 else 1.0
	local premMult = if player.MembershipType == Enum.MembershipType.Premium
		then GameConfig.PREMIUM_COIN_MULTIPLIER
		else 1.0
	local coinsFromRoll = math.max(1, math.floor(5 * equippedAura.CoinMultiplier * rebMult * vipMult * premMult))
	profile.Coins += coinsFromRoll

	-- Add newly rolled Aura to Vault if not already owned (and within capacity)
	local maxSlots = DataManager.GetMaxVaultSlots(player)
	if not table.find(profile.OwnedAuras, bestAura.Id) then
		if #profile.OwnedAuras < maxSlots then
			table.insert(profile.OwnedAuras, bestAura.Id)
		elseif bestAura.OneIn > profile.BestAuraOneIn then
			-- Always guarantee space for a new personal-best Aura!
			table.insert(profile.OwnedAuras, bestAura.Id)
		end
	end

	-- Auto-equip if strictly rarer than current best
	if bestAura.OneIn > profile.BestAuraOneIn then
		profile.BestAuraId = bestAura.Id
		profile.BestAuraOneIn = bestAura.OneIn
		profile.EquippedAuraId = bestAura.Id
		refreshCharacterVisuals(player)
	end

	-- Global Server Broadcast for 1-in-10,000+ Legendary / Mythic / Celestial rolls!
	if bestAura.ServerAnnounce then
		ServerAnnounceEvent:FireAllClients(
			string.format(
				"🌌 %s JUST ROLLED [%s] (1 IN %d) AT %.1fX LUCK! 🌌",
				player.DisplayName,
				string.upper(bestAura.Name),
				bestAura.OneIn,
				breakdown.TotalLuck
			),
			bestAura.PrimaryColor
		)
	end

	DataManager.MarkDirty(player)
	syncPlayerState(player)

	local batchIds: { string } = {}
	for _, a in ipairs(allRolled) do
		table.insert(batchIds, a.Id)
	end

	RollResultEvent:FireClient(player, {
		BestAuraId = bestAura.Id,
		AllAuraIds = batchIds,
		UsedPotion = consumePotion,
		CoinsEarned = coinsFromRoll,
		EffectiveLuck = breakdown.TotalLuck,
	})

	return true, bestAura.Name
end

-- Wire World Callbacks
WorldBuilder.BuildWorld(
	function(player: Player) -- Obby Summit Pad
		local profile = DataManager.GetProfile(player)
		if not profile then
			return
		end
		obbyBuffExpiry[player] = os.time() + GameConfig.OBBY_BUFF_DURATION
		profile.Coins += 500
		profile.Gems += 25
		DataManager.MarkDirty(player)
		syncPlayerState(player)
		ServerAnnounceEvent:FireClient(
			player,
			"🏆 Sky Obby Conquered! +100% (2X) Roll Luck for 5m + 500 Coins + 25 Gems!",
			Color3.fromRGB(50, 255, 130)
		)
	end,
	function(player: Player) -- VIP Fountain
		local profile = DataManager.GetProfile(player)
		if not profile then
			return
		end
		if MonetizationServer.OwnsGamepass(player, "VIP") or profile.Rebirths >= 3 then
			vipFountainExpiry[player] = os.time() + 300
			syncPlayerState(player)
			ServerAnnounceEvent:FireClient(
				player,
				"👑 VIP Sanctum Blessing Active: +35% Bonus Luck for 5 minutes!",
				Color3.fromRGB(255, 215, 50)
			)
		else
			MonetizationServer.PromptOrSimulatePurchase(player, "Gamepass", "VIP")
		end
	end,
	function(player: Player, kind: string, key: string) -- 3D Shop Pedestals
		local ok, msg = MonetizationServer.PromptOrSimulatePurchase(player, kind, key)
		if ok then
			ServerAnnounceEvent:FireClient(player, msg, Color3.fromRGB(0, 235, 255))
		end
	end
)

-- Wire Monetization & Boss Callbacks
MonetizationServer.OnServerAnnouncement = function(msg: string, color: Color3)
	ServerAnnounceEvent:FireAllClients(msg, color)
	for _, p in ipairs(Players:GetPlayers()) do
		syncPlayerState(p)
	end
end

MonetizationServer.OnForceSpawnOmegaBoss = function(_player: Player)
	local omegaDef = GameConfig.Bosses[#GameConfig.Bosses]
	CombatAndBossServer.SpawnBoss(omegaDef, 3.0)
end

MonetizationServer.OnProfileUpdated = function(player: Player)
	refreshCharacterVisuals(player)
	syncPlayerState(player)
end

CombatAndBossServer.OnBossStateChanged = function(name: string, hp: number, maxHp: number, color: Color3)
	BossStateEvent:FireAllClients({
		Name = name,
		HP = hp,
		MaxHP = maxHp,
		Color = color,
	})
end

CombatAndBossServer.OnBossDefeated = function(player: Player, bossName: string, coins: number, gems: number, fastRolls: number)
	syncPlayerState(player)
	ServerAnnounceEvent:FireClient(
		player,
		string.format("⚔️ %s Defeated! +%d Coins, +%d Gems, +%d Fast Rolls!", bossName, coins, gems, fastRolls),
		Color3.fromRGB(255, 195, 45)
	)
end

-- Client Combat Slash RemoteEvent
CombatSlashEvent.OnServerEvent:Connect(function(player: Player)
	local hit, dmg, isCrit = CombatAndBossServer.HandlePlayerSlash(player)
	if hit then
		CombatHitFeedbackEvent:FireClient(player, dmg, isCrit)
		syncPlayerState(player)
	end
end)

-- Unified Client Action Request Handler
ActionRequestFunc.OnServerInvoke = function(player: Player, action: string, payload: any): (boolean, string)
	local profile = DataManager.GetProfile(player)
	if not profile then
		return false, "Profile not loaded yet"
	end

	if action == "Roll" then
		local usePotion = type(payload) == "table" and payload.UsePotion == true
		local useFast = type(payload) == "table" and payload.UseFastToken == true
		return performPlayerRoll(player, usePotion, useFast)

	elseif action == "ToggleAutoRoll" then
		if not MonetizationServer.OwnsGamepass(player, "AutoRoll") and profile.Rebirths < 2 then
			local ok, msg = MonetizationServer.PromptOrSimulatePurchase(player, "Gamepass", "AutoRoll")
			return ok, msg
		end
		profile.AutoRollEnabled = not profile.AutoRollEnabled
		DataManager.MarkDirty(player)
		syncPlayerState(player)
		return true, if profile.AutoRollEnabled then "Auto-Roll ENABLED" else "Auto-Roll PAUSED"

	elseif action == "EquipAura" then
		local auraId = tostring(payload)
		if not table.find(profile.OwnedAuras, auraId) then
			return false, "You don't own that Aura yet!"
		end
		profile.EquippedAuraId = auraId
		DataManager.MarkDirty(player)
		refreshCharacterVisuals(player)
		syncPlayerState(player)
		local aura = GameConfig.GetAuraById(auraId)
		return true, "Equipped " .. aura.Name .. "!"

	elseif action == "Rebirth" then
		local nextTier = GameConfig.GetRebirthTier(profile.Rebirths + 1)
		if not nextTier then
			return false, "You have reached Maximum Rebirth (OMEGA DEITY)!"
		end
		if profile.Coins < nextTier.CoinCost then
			return false, string.format("Need %d Flux Coins to Rebirth!", nextTier.CoinCost)
		end
		if profile.BestAuraOneIn < nextTier.RequiredAuraOneIn then
			return false, string.format("Need a 1-in-%d+ Aura to Rebirth!", nextTier.RequiredAuraOneIn)
		end

		profile.Coins = 0
		profile.Rebirths = nextTier.Level
		profile.Gems += (nextTier.Level * 75)
		profile.FastRollTokens += 5
		DataManager.MarkDirty(player)
		refreshCharacterVisuals(player)
		syncPlayerState(player)

		ServerAnnounceEvent:FireAllClients(
			string.format("🔥 %s ascended to REBIRTH %d [%s]!", player.DisplayName, nextTier.Level, nextTier.Title),
			Color3.fromRGB(255, 175, 40)
		)
		return true, string.format("Rebirth %d Unlocked: %s!", nextTier.Level, nextTier.Title)

	elseif action == "BuyShopItem" then
		if type(payload) ~= "table" then
			return false, "Invalid request"
		end
		return MonetizationServer.PromptOrSimulatePurchase(player, tostring(payload.Kind), tostring(payload.Key))

	elseif action == "BuyGemItem" then
		local itemId = tostring(payload)
		for _, item in ipairs(GameConfig.GemShopItems) do
			if item.Id == itemId then
				if profile.Gems < item.GemCost then
					return false, "Not enough Luck Gems!"
				end
				profile.Gems -= item.GemCost
				if itemId == "gem_heavenly_potion" then
					profile.HeavenlyPotions += 1
				elseif itemId == "gem_fast_rolls_25" then
					profile.FastRollTokens += 25
				elseif itemId == "gem_vault_slots_10" then
					profile.BonusVaultSlots += 10
				end
				DataManager.MarkDirty(player)
				syncPlayerState(player)
				return true, "Purchased " .. item.Name .. "!"
			end
		end
		return false, "Unknown Gem Shop item"

	elseif action == "ClaimDaily" then
		local currentDay = math.floor(os.time() / 86400)
		if profile.LastDailyClaimDay == currentDay then
			return false, "Daily Reward already claimed today! Come back tomorrow!"
		end
		if profile.LastDailyClaimDay == currentDay - 1 then
			profile.DailyStreak = (profile.DailyStreak % #GameConfig.DailyRewards) + 1
		else
			profile.DailyStreak = 1
		end
		profile.LastDailyClaimDay = currentDay
		local reward = GameConfig.DailyRewards[profile.DailyStreak]
		profile.Coins += reward.Coins
		profile.Gems += reward.Gems
		profile.HeavenlyPotions += reward.Potions
		DataManager.MarkDirty(player)
		syncPlayerState(player)
		return true, string.format("Day %d Claimed: %s!", reward.Day, reward.Label)

	elseif action == "RedeemCode" then
		local code = string.upper(string.gsub(tostring(payload or ""), "%s+", ""))
		local codeReward = GameConfig.PromoCodes[code]
		if not codeReward then
			return false, "Invalid or expired code! Try: RELEASE, OMEGA2026, LUCKY777, CYBERBLADE"
		end
		if profile.RedeemedCodes[code] then
			return false, "Code '" .. code .. "' already redeemed!"
		end
		profile.RedeemedCodes[code] = true
		profile.Coins += codeReward.Coins
		profile.Gems += codeReward.Gems
		profile.HeavenlyPotions += codeReward.Potions
		DataManager.MarkDirty(player)
		syncPlayerState(player)
		return true, string.format("Code %s: +%d Coins, +%d Gems, +%d Potions!", code, codeReward.Coins, codeReward.Gems, codeReward.Potions)

	elseif action == "RequestState" then
		syncPlayerState(player)
		return true, "Synced"
	end

	return false, "Unknown action"
end

-- Player Lifecycle Connections
local function onPlayerAdded(player: Player)
	local profile = DataManager.LoadProfile(player)
	MonetizationServer.SyncPlayerGamepasses(player)

	player.CharacterAdded:Connect(function(_character)
		task.wait(0.25)
		refreshCharacterVisuals(player)
	end)

	if player.Character then
		task.spawn(function()
			refreshCharacterVisuals(player)
		end)
	end

	task.delay(0.5, function()
		if player.Parent then
			syncPlayerState(player)
			if CombatAndBossServer.CurrentBoss then
				local b = CombatAndBossServer.CurrentBoss
				BossStateEvent:FireClient(player, {
					Name = b.Def.Name,
					HP = b.CurrentHP,
					MaxHP = b.MaxHP,
					Color = b.Def.PrimaryColor,
				})
			end
		end
	end)
	local _ = profile
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, existingPlayer in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, existingPlayer)
end

Players.PlayerRemoving:Connect(function(player: Player)
	obbyBuffExpiry[player] = nil
	vipFountainExpiry[player] = nil
	lastRollTimestamp[player] = nil
	DataManager.CleanupPlayer(player)
end)

-- Server Auto-Roll & Periodic HUD Sync Loop
task.spawn(function()
	while true do
		task.wait(0.65)
		for _, player in ipairs(Players:GetPlayers()) do
			local profile = DataManager.GetProfile(player)
			if profile and profile.AutoRollEnabled then
				performPlayerRoll(player, false, false)
			end
		end
	end
end)

MonetizationServer.Init()
VisualAuraBuilder.StartOrbitLoop()
DataManager.StartAutoSaveLoop()
CombatAndBossServer.StartDirectorLoop()
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
